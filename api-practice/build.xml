<?xml version="1.0" encoding="UTF-8"?>
<project name="api-practice" default="default" basedir=".">
    <description>Builds, tests, and runs the project api-practice.</description>

    <!--
        Descarga automática de Gson para mantener el repositorio sin binarios.
        Se ejecuta antes de compilar con Ant.
    -->
    <property name="gson.version" value="2.10"/>
    <property name="gson.jar.path" value="${basedir}/lib/gson-${gson.version}.jar"/>
    <property name="gson.download.url" value="https://repo1.maven.org/maven2/com/google/code/gson/gson/${gson.version}/gson-${gson.version}.jar"/>

    <target name="download-deps" description="Descarga dependencias necesarias si no existen.">
        <mkdir dir="${basedir}/lib"/>
        <get src="${gson.download.url}" dest="${gson.jar.path}" skipexisting="true"/>
    </target>

    <target name="-pre-compile" depends="download-deps"/>

    <import file="nbproject/build-impl.xml"/>
</project>
